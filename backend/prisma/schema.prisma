// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model STUDENT_SCORE {
  SoBaoDanh String @id @db.VarChar(8)
  DiemToan Decimal? @db.Decimal(4,2)
  NguVan Decimal? @db.Decimal(4,2)
  NgoaiNgu Decimal? @db.Decimal(4,2)
  VatLi Decimal? @db.Decimal(4,2)
  HoaHoc Decimal? @db.Decimal(4,2)
  SinhHoc Decimal? @db.Decimal(4,2)
  LichSu Decimal? @db.Decimal(4,2)
  DiaLi Decimal? @db.Decimal(4,2)
  GDCD Decimal? @db.Decimal(4,2)
  MaNgoaiNgu String?
}
